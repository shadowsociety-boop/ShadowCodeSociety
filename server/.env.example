# ============================================
# Shadow Code Society — Server Environment
# ============================================

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/shadow_code?schema=public"

# JWT
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_REFRESH_SECRET="change-me-to-another-random-64-char-string"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"

# Client
CLIENT_URL="http://localhost:5173"

# Storage (local dev — switch to S3/R2 for production)
STORAGE_TYPE="local"
STORAGE_PATH="./uploads"
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# Email (optional)
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASSWORD=
