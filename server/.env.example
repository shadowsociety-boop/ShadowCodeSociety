# ============================================
# Shadow Code Society — Server Environment
# ============================================

# Database (Supabase PostgreSQL or Local)
# Supabase format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:password@localhost:5432/shadow_code?schema=public"

# JWT Auth
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_REFRESH_SECRET="change-me-to-another-random-64-char-string"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=5001
NODE_ENV="development"
COOKIE_SAMESITE="lax" # Set to "none" in production for cross-site cookies between Vercel & Render

# Client (Vercel Frontend or Local)
CLIENT_URL="http://localhost:5173"

# Cloudinary Cloud Storage (for member photos, event posters, highlights)
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Or single connection URL:
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# Storage fallback (local dev)
STORAGE_TYPE="local"
STORAGE_PATH="./uploads"

# Redis Cache / Rate Limit (Optional)
# Format: redis://default:<password>@<host>:<port>
REDIS_URL=""

# Email (optional)
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASSWORD=
